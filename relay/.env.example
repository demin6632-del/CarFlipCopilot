# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# URL of the running relay, e.g. https://your-relay.example.com
RELAY_URL=
# Must match the relay's COPILOT_TOKEN
COPILOT_TOKEN=
# Game bot username without @
GAME_BOT_USERNAME=m0dsbeamngbot
# Optional Telegram Web App URL for an official game/account connection flow
GAME_CONNECT_URL=
# Optional OpenAI key for AI analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Public HTTPS URL serving the Telegram user-session connection page
BRIDGE_PUBLIC_URL=
# Local port for the connection page
BRIDGE_PORT=8787
# Telegram API ID/hash from my.telegram.org (keep secret; never send them in chat)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: existing GramJS StringSession; otherwise a local session file is used
TELEGRAM_SESSION=
TELEGRAM_SESSION_FILE=data/telegram-user-session.txt
# Optional Telegram 2FA password, only as a server secret
TELEGRAM_2FA_PASSWORD=
